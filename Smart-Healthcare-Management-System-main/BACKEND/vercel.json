{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "express"
    },
    "ai-model": {
      "root": "ai-model",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "app" }
    },
    {
      "source": "/chat/(.*)",
      "destination": { "service": "ai-model" }
    }
  ]
}
