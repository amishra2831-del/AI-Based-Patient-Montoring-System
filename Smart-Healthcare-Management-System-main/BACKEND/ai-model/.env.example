# ============================================================
# AI service environment variables (FastAPI)
# ============================================================
# Local:  copy to .env and load it with your process manager.
# Vercel: add these under Settings > Environment Variables.

# ---- CORS ----
# Public origin(s) of the deployed frontend. Comma-separated is supported.
FRONTEND_URL=http://localhost:5173
FRONTEND01=
FRONTEND02=
CORS_ALLOWED_ORIGINS=

# ---- Database (optional) ----
# The chatbot works without MongoDB; it only falls back to default vitals.
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=healthcare
MONGO_VITALS_COLLECTION=vitals

# ---- Model ----
# Seconds allowed for the model.py subprocess before it is aborted.
MODEL_TIMEOUT_SECONDS=8