# ============================================================
# Backend environment variables (Express API)
# ============================================================
# Copy to .env for local development, or set these in your hosting
# provider's dashboard for production. Never commit real secrets.

# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# Local:  mongodb://127.0.0.1:27017/mediflow
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mediflow?retryWrites=true&w=majority

# ---- Auth ----
# Use a long random value in production, e.g. openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret

# ---- CORS ----
# Public origin(s) of the deployed frontend. Comma-separated is supported.
FRONTEND_URL=http://localhost:5173
# Optional extra origins (previews, staging, custom domains)
FRONTEND01=http://localhost:5173
FRONTEND02=
CORS_ALLOWED_ORIGINS=

# ---- AI service (FastAPI) ----
# Public origin of the deployed AI service, without a trailing slash.
AI_API_URL=http://localhost:8000
AI_REQUEST_TIMEOUT_MS=20000

# ---- Email (password reset) ----
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password

# ---- Uploads ----
# Optional. Defaults to BACKEND/uploads locally and /tmp/uploads on
# serverless platforms.
# UPLOAD_DIR=