# ============================================================
# Frontend environment variables (React + Vite)
# ============================================================
#
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# Never put secrets (Mongo URIs, JWT secrets, email passwords) in this file.
#
# All API calls in the app are built as:
#   ${VITE_API_URL}/api/...
# so VITE_API_URL must be the backend ORIGIN only, with no /api suffix.

# ---- Backend (Express) origin ----
# Local:  http://localhost:5000
# Prod:   https://<your-backend-domain>
VITE_API_URL=http://localhost:5000

# ---- AI service (FastAPI) origin ----
# Local:  http://localhost:8000
# Prod:   https://<your-ai-service-domain>
VITE_CHAT_API_URL=http://localhost:8000